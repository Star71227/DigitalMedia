# Dependencies
node_modules/
.npm-cache/

# Build output
build/
dist/
coverage/
backend/storage/resources/
backend/storage/reports/
backend/storage/temp/
backups/

# Logs
*.log
npm-debug.log*
frontend-dev.*.log
backend-dev*.log

# Environment
.env
.env.*
!.env.example
!.env.docker.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime generated artifacts (courseware / reports produced at runtime)
storage/

# Local model downloads and disposable training artifacts
.ai-cache/
ai-training/logs/
ai-training/scripts/__pycache__/
ai-training/output/**/checkpoint-*/

# Knowledge-graph frontend delivery backups (kept on disk, not tracked)
frontend-new/.dsh-backup-*/
frontend-teacher/.dsh-backup-*/

# Local delivery archives and editor backups
LearnMate-*.zip
LearnMate-*.sha256
*.bak-*

# Local service logs and process IDs
.local-runtime/

# Bundled portable C toolchain (regenerated by packaging/desktop/tools/fetch-compiler.ps1)
packaging/desktop/compiler/

# Trained model weights / tokenizer copies (re-download base model to regenerate; not loaded at runtime)
*.safetensors
ai-training/output/**/tokenizer.json

# Stale static preview builds (snapshot HTML + bundled assets, superseded by src/)
preview-*/
