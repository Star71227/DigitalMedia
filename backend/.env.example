# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=5800
TZ=Asia/Shanghai

# MySQL (DB_PASSWORD is required; production rejects missing/example values.)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-database-password
DB_NAME=edusmart
DB_CONNECT_TIMEOUT_MS=5000
DB_INIT_MAX_ATTEMPTS=15
DB_INIT_RETRY_MS=2000

# Authentication (production requires at least 32 non-placeholder characters.)
JWT_SECRET=change-me-use-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Comma-separated exact browser origins. Production never accepts a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Persistent storage. Relative paths are resolved from the backend working directory.
RESOURCE_STORAGE_DIR=./storage/resources
REPORT_STORAGE_DIR=./storage/reports

# Startup automation is opt-in and idempotent. It never resets demo data.
KNOWLEDGE_IMPORT_ON_START=false
SEED_DEMO_DATA=false
DEMO_PASSWORD=change-me-demo-password
# One-time legacy-volume migration only. Leave empty during normal seed/startup.
DEMO_ADOPT_LEGACY_CONFIRM=

# ============================================================================
# 组员零配置模式（默认）：直接用队长机器上的模型转发口，不用自己申请/填 key
# ----------------------------------------------------------------------------
# 队长在**自己机器**上执行一次：cd backend && node scripts/llm-relay.js
#   · 转发口默认监听 8090，key 只留在队长机器上，组员那边看不到也用不到 key
#   · 队长机器关机/离开同一局域网时，组员会连不上——这时改用下面「自己填 key」的写法
# 组员保持下面这套即可（LLM_MODEL 留空也行，转发口会用队长机器配置的模型）：
LLM_PROVIDER=local-llamafactory
LLM_API_URL=http://192.168.1.4:8090/v1/chat/completions
LLM_API_KEY=
LLM_VISION_MODEL=
LLM_TUTOR_MODEL=
LLM_PLANNER_MODEL=
LLM_QUIZ_MODEL=
LLM_MODEL=
# 允许访问内网/私网地址的模型端点（免密钥端点只在内网可信地址上被接受）
LLM_LOCAL_ALLOW_PRIVATE=true
# 想改成「自己填 key 直连智谱」时，把上面六行注释掉，改用下面这套：
# LLM_PROVIDER=bigmodel
# LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# LLM_API_KEY=<你自己的智谱 API Key>
# LLM_MODEL=glm-5.3-flashx
# LLM_VISION_MODEL=glm-5.3-flash
# LLM_TUTOR_MODEL=glm-5.3-flashx
# LLM_PLANNER_MODEL=glm-5.3
# LLM_QUIZ_MODEL=glm-5.3-flash
# ============================================================================

# 显式 AI 总开关。默认**打开**：只要在下面填了 LLM_API_KEY，AI 学习助手/资源生成就是
# 真实模型效果，和你演示的机器一致。**没有填 key 时后端会自动退回确定性兜底**
# （isAIEnabled 会返回 false），不会报错、也不会假装是模型答的。
# 注意这三个开关必须是 true，否则「AI 助手用不了/回答像模板」基本都是这里没开：
#   AI_ENABLED                     AI 学习助手对话
#   MULTIMODAL_RESOURCE_AI_ENABLED 讲义/课件/思维导图/练习包等资源生成
#   MULTIMODAL_REVIEW_AI_ENABLED   生成结果的模型复核（关了会少一层审核）
AI_ENABLED=true
PATH_PLANNER_AI_ENABLED=false
MULTIMODAL_RESOURCE_AI_ENABLED=true
MULTIMODAL_REVIEW_AI_ENABLED=true

# Optional iFlytek Spark configuration; required only when AI_ENABLED=true.
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_MODEL=lite
SPARK_API_KEY=
SPARK_APP_ID=
SPARK_API_SECRET=
# Keep provider calls bounded; grounded chats fall back to local course evidence on timeout.
SPARK_TIMEOUT_MS=20000

# Recommended provider-neutral settings for an OpenAI-compatible HTTP model API.
# For wrong-question image recognition, LLM_MODEL must support image_url input.
# LLM_API_KEY belongs only in the ignored root .env file; never commit a real key.
# Local LLaMA Factory example (keyless access is accepted only on localhost):
# LLM_PROVIDER=local-llamafactory
# LLM_API_URL=http://127.0.0.1:8000/v1/chat/completions
# LLM_MODEL=Qwen3-VL-2B-Instruct
# Full-stack launcher sets this only when WSL2 NAT requires a private 172.16/12 address.
LLM_LOCAL_ALLOW_PRIVATE=false
LLM_PROVIDER=openai-compatible
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_TUTOR_MODEL=
LLM_PLANNER_MODEL=
LLM_QUIZ_MODEL=
# 本地 2B 视觉语言模型首次加载较慢，建议 180 秒；远程接口可按需降至 20 秒。
LLM_TIMEOUT_MS=180000

# 智谱 BigModel（GLM）示例：LLM_API_KEY 自己填，不要提交真实 key。
# LLM_PROVIDER=bigmodel
# LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# LLM_MODEL=glm-5.3-flashx
# LLM_VISION_MODEL=glm-5.3-flash
# LLM_TUTOR_MODEL=glm-5.3-flashx
# LLM_PLANNER_MODEL=glm-5.3
# LLM_QUIZ_MODEL=glm-5.3-flash
#
# 注意：GLM 5.x 是推理模型，正文之前会先输出 reasoning_content。
# 如果 max_tokens 给得太小（例如 9000），推理过程会把额度吃光、正文字符串为空，
# 资源生成会直接失败。资源生成链路已按 2 万左右配置，自建调用时请留足额度。
#
# 结构化输出：部分服务商对 response_format 支持不一致，默认关闭；
# 智谱 OpenAI 兼容接口支持，开启后出题/评估/资源生成这类"只吐 JSON"的环节更稳。
# LLM_JSON_MODE=response_format
# 单次模型调用上限（毫秒）。资源生成是"生成 → 质量门禁 → 反馈重写"的多轮链路，不要设太小。
LLM_MAX_TIMEOUT_MS=180000
# 使用真实模型时还需要把下面这些开关打开，否则会安静地走确定性兜底、看起来像"模型没生效"：
#   AI_ENABLED=true
#   MULTIMODAL_RESOURCE_AI_ENABLED=true
#   MULTIMODAL_REVIEW_AI_ENABLED=true

# Optional web-search adapter used by personalized quiz generation. The endpoint
# receives POST JSON {query,count} and should return results/items/data entries
# containing title, url/link and snippet/description/content.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=baidu-html
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=12000

# PDF generation. Windows can normally auto-discover Edge and CJK fonts.
# The backend Docker image sets these to Chromium and Noto Sans CJK.
REPORT_BROWSER_PATH=
REPORT_FONT_PATH=

# Restricted local CodeLab C judge. Default is disabled; set docker only when
# Docker Desktop/Linux Engine and the runner image have been verified locally.
CODE_EXECUTION_MODE=disabled
CODE_RUNNER_IMAGE=learnmate/code-runner-c:2.4a
CODE_RUNNER_TRANSPORT=native
CODE_RUNNER_WSL_DISTRO=Ubuntu-24.04
CODE_RUNNER_MEMORY=128m
CODE_RUNNER_MEMORY_SWAP=128m
CODE_RUNNER_CPUS=0.5
CODE_RUNNER_PIDS_LIMIT=64
CODE_RUNNER_NOFILE_LIMIT=64
CODE_RUNNER_NPROC_LIMIT=64
CODE_RUNNER_MAX_SOURCE_BYTES=65536
CODE_RUNNER_MAX_INPUT_BYTES=32768
CODE_RUNNER_MAX_OUTPUT_BYTES=65536
CODE_RUNNER_MAX_TESTS=20
CODE_RUNNER_COMPILE_TIMEOUT_MS=5000
CODE_RUNNER_CASE_TIMEOUT_MS=2000
CODE_RUNNER_TOTAL_TIMEOUT_MS=15000
CODE_RUNNER_WORK_TMPFS_SIZE=64m
CODE_RUNNER_TMP_TMPFS_SIZE=16m
# 教师端注册：open=开放自助注册 / closed=关闭
TEACHER_REGISTRATION_MODE=open

# baidu-html and bing-rss need no key; generic-json uses WEB_SEARCH_API_URL and WEB_SEARCH_API_KEY.
